# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (do NOT commit real secrets)
.env*
!.env.example

# vercel / netlify deployment artifacts
.vercel

# typescript build cache
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/

# empty/personal folders
J-A-R-V-I-S/

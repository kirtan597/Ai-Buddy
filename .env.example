# ─── AI Provider (OpenRouter) ────────────────────────────────────────────────
# Get your API key from: https://openrouter.ai
OPENAI_API_KEY=sk-or-your-openrouter-key-for-chat
OPENROUTER_API_KEY_IMAGE=sk-or-your-openrouter-key-for-image

# ─── Database ─────────────────────────────────────────────────────────────────
# Get your connection string from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-buddy

# ─── Authentication (Google OAuth) ────────────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret

# Set to your local dev URL or production domain
# LOCAL development:
NEXTAUTH_URL=http://localhost:3000
# PRODUCTION (replace with your own domain):
# NEXTAUTH_URL=https://your-app.netlify.app

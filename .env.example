# ─── AI Provider (OpenRouter) ────────────────────────────────
OPENAI_API_KEY=sk-or-your-openrouter-key-for-chat
OPENROUTER_API_KEY_IMAGE=sk-or-your-openrouter-key-for-image
OPENROUTER_API_KEY_VIDEO=sk-or-your-openrouter-key-for-video

# ─── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-buddy

# ─── Authentication ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=your-random-secret   # generate: openssl rand -base64 32

# LOCAL development:
# NEXTAUTH_URL=http://localhost:3000
# PRODUCTION (Netlify):
NEXTAUTH_URL=https://kbotai.netlify.app
